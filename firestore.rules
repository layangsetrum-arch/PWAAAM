rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Services Subcollection
      match /services/{serviceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(serviceId)
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
          && incoming().urlTemplate is string && incoming().urlTemplate.size() <= 500
          && incoming().usesAuthuser is bool;
        allow update: if isOwner(userId) && isValidId(serviceId)
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
          && incoming().urlTemplate is string && incoming().urlTemplate.size() <= 500
          && incoming().usesAuthuser is bool
          && incoming().id == existing().id;
      }

      // Persons Subcollection
      match /persons/{personId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(personId)
          && incoming().ownerName is string && incoming().ownerName.size() > 0 && incoming().ownerName.size() <= 100
          && incoming().googleEmail is string && incoming().googleEmail.size() <= 150;
        allow update: if isOwner(userId) && isValidId(personId)
          && incoming().ownerName is string && incoming().ownerName.size() > 0 && incoming().ownerName.size() <= 100
          && incoming().googleEmail is string && incoming().googleEmail.size() <= 150
          && incoming().id == existing().id;
      }

      // Access Subcollection
      match /access/{accessId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accessId)
          && incoming().personId is string
          && incoming().serviceId is string
          && incoming().status in ['ready', 'limited'];
        allow update: if isOwner(userId) && isValidId(accessId)
          && incoming().personId == existing().personId
          && incoming().serviceId == existing().serviceId
          && incoming().status in ['ready', 'limited']
          && incoming().id == existing().id;
      }

      // Usage Logs Subcollection
      match /logs/{logId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId)
          && incoming().accessId is string
          && incoming().type in ['opened', 'stop', 'limit_hit', 'reset_ready', 'note']
          && incoming().at is string;
        allow update: if false; // Logs are immutable once written
      }

      // Handoff Notes Subcollection
      match /handoffNotes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId)
          && incoming().serviceId is string
          && incoming().accessId is string
          && incoming().authorName is string && incoming().authorName.size() <= 100
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000;
        allow update: if isOwner(userId) && isValidId(noteId)
          && incoming().serviceId == existing().serviceId
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000
          && incoming().id == existing().id;
      }

      // Settings Subcollection
      match /settings/{settingsId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingsId)
          && incoming().resetTimezone is string && incoming().resetTimezone.size() <= 50
          && incoming().maxPersons is number && incoming().maxPersons <= 10;
      }
    }
  }
}
